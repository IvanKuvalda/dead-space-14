<apphub:NtSoftwareHubCartridgeFragment xmlns:apphub="clr-namespace:Content.Client.DeadSpace.AppHub"
                                        xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                                        xmlns="https://spacestation14.io" Margin="1 0 2 0">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="4">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="4 2">
            <Label Name="TitleLabel" StyleClasses="LabelBig" HorizontalExpand="True" />
            <Label Name="StatusLabel" FontColorOverride="#88FF88" VerticalAlignment="Center" Margin="4 0" />
        </BoxContainer>
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="4 0" SeparationOverride="8">
            <Label Name="MemoryLabel" VerticalAlignment="Center" StyleClasses="LabelSubText" />
            <ProgressBar Name="MemoryBar" MinValue="0" MaxValue="8" Value="0" MinHeight="16" HorizontalExpand="True" />
        </BoxContainer>
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="4 2" SeparationOverride="4">
            <Button Name="CategoryAll" MinHeight="26" HorizontalExpand="True" />
            <Button Name="CategoryTools" MinHeight="26" HorizontalExpand="True" />
            <Button Name="CategoryEquipment" MinHeight="26" HorizontalExpand="True" />
            <Button Name="CategoryGames" MinHeight="26" HorizontalExpand="True" />
        </BoxContainer>
        <PanelContainer HorizontalExpand="True" MinHeight="1" Margin="4 0">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#555555FF" />
            </PanelContainer.PanelOverride>
        </PanelContainer>
        <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False" Margin="2 0">
            <BoxContainer Name="ProgramListContainer" Orientation="Vertical" SeparationOverride="4" Margin="2" />
        </ScrollContainer>
    </BoxContainer>
</apphub:NtSoftwareHubCartridgeFragment>
